{
  "name": "pecuaria-smart",
  "version": "1.0.0",
  "description": "Sistema de identificação e monitoramento de bovinos confinados — Pecuária Smart",
  "main": "backend/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "seed": "node backend/server.js --seed",
    "migrate": "node backend/db/migrate.js",
    "test": "node --test",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "pecuaria",
    "bovinos",
    "confinamento"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "node-webcam": "^0.8.2",
    "serialport": "^12.0.0",
    "tesseract.js": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.1.0"
  }
}
