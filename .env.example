# Variáveis de ambiente para Pecuária Smart
# Copie este arquivo para .env e configure com seus valores

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
DB_PATH=data/pecuaria.db

# CORS
CORS_ORIGIN=http://localhost:3000

# Hardware - Câmera
CAMERA_DEVICE_ID=0

# Hardware - Balança (Serial)
SCALE_PORT=COM3
SCALE_BAUD_RATE=9600

# Logging
LOG_LEVEL=info